# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Service role key for background due-date reminder cron jobs (see DEBTSYNC_INTERNAL_API_SECRET)
SUPABASE_SERVICE_ROLE_KEY=

# Application URL (used for auth callbacks, email CTAs, and canonical share links)
NEXT_PUBLIC_APP_URL=https://debt-sync.satya-nayak.dev

# Web Push Notifications (VAPID Public Key for PWA Push Subscriptions)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-Only Discord Webhook (Used by /api/bug-report and /api/contact — NEVER expose with NEXT_PUBLIC_)
DISCORD_WEBHOOK_URL=
DISCORD_BUG_WEBHOOK_URL=
# Alias supported by Cloudflare env (either URL or URI suffix works)
DISCORD_BUG_WEBHOOK_URI=

# Protects /api/reminders/due-date and /api/notifications/email (server/cron only — never NEXT_PUBLIC_)
DEBTSYNC_INTERNAL_API_SECRET=
# Legacy alias still supported in code
CRON_SECRET=

# Optional: Transactional Email Delivery (Resend API fallback alongside Supabase Edge Function `notify`)
RESEND_API_KEY=
EMAIL_FROM=DebtSync <notifications@debt-sync.satya-nayak.dev>
